# Handle line endings automatically for text files and force LF on checkout
* text=auto eol=lf

# Explicitly ensure common text files use LF
*.txt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Deny line ending conversions for binary files (images, zip, etc.)
*.png binary
*.jpg binary
*.gif binary
